# Local development database settings.
POSTGRES_DB=petroedge
POSTGRES_USER=petroedge
POSTGRES_PASSWORD=petroedge_dev
POSTGRES_PORT=5432

GRPC_PORT=50051

# Services running on the host use localhost; containers use postgres:5432.
DATABASE_URL=postgres://petroedge:petroedge_dev@localhost:5432/petroedge?sslmode=disable
